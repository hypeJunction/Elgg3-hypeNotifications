{
    "name": "hypejunction/hypenotifications",
    "type": "elgg-plugin",
    "description": "Enhanced on-site and off-site notifications",
    "homepage": "https://github.com/hypeJunction/hypenotifications",
    "keywords": [
        "elgg",
        "plugin",
        "notifications"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "hypeJunction",
            "homepage": "https://github.com/hypeJunction"
        }
    ],
    "extra": {
        "installer-name": "hypenotifications",
        "elgg-plugin": {
            "id": "hypenotifications"
        }
    },
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.0",
        "laminas/laminas-mail": "^2.26",
        "laminas/laminas-servicemanager": "^3.22",
        "pelago/emogrifier": "^7.0",
        "sendgrid/sendgrid": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "sparkpost/sparkpost": "^2.1",
        "mailgun/mailgun-php": "^4.0",
        "elgg/elgg": "^5.0"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        },
        "files": [
            "lib/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
